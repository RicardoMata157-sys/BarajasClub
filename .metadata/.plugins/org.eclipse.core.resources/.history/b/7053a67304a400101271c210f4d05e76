<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">

<style>
  .bg-hero {
    background: radial-gradient(120% 120% at 80% 10%, #0d6efd 0%, #151824 60%, #0b0e16 100%);
  }
  .text-shadow { text-shadow: 0 2px 8px rgba(0,0,0,.35); }
  .glass {
    backdrop-filter: blur(8px);
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 1rem;
  }
  .raffle-card {
    border: 1px solid rgba(0,0,0,.06);
    transition: transform .15s ease, box-shadow .15s ease;
    overflow: hidden;
    border-radius: 1rem;
  }
  .raffle-card:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,0,0,.12); }
  .ratio > img { object-fit: cover; }
  .img-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.55), rgba(0,0,0,0) 45%);
  }
  .badge-estado { position: absolute; top: .75rem; right: .75rem; z-index: 3; }
  .price-tag {
    font-weight: 700; font-size: 1.05rem;
  }
  .progress-sm .progress-bar { height: .5rem; }
  .filter-pills .btn-check:checked + .btn,
  .filter-pills .btn:hover { border-color: #0d6efd; }
  .countdown {
    font-variant-numeric: tabular-nums;
    font-size: .9rem;
    opacity: .9;
  }
</style>


  <head th:replace="~{fragments :: head('CLUB BARAJAS')}"></head>
  
  <th:block th:replace="~{fragments :: scripts}"></th:block>
  <body>
    <header th:replace="~{fragments :: navbar}"></header>

    <section class="py-5 bg-hero text-white">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-12 col-lg-7">
        <h1 class="display-5 fw-bold mb-3 text-shadow">Barajas Club</h1>
        <p class="lead mb-4 text-white-50">
          Participa en las ediciones activas y gana premios increíbles. ¡Cupos limitados, entra ya!
        </p>
        <div class="d-flex flex-wrap gap-3">
          <a href="#explorar" class="btn btn-primary btn-lg">Ver ediciones</a>
          <a href="#" data-bs-toggle="modal" data-bs-target="#comoFuncionaModal" class="btn btn-outline-light btn-lg">
            ¿Cómo funciona?
          </a>
        </div>
      </div>
      <div class="col-12 col-lg-5">
        <div class="glass p-4">
          <h2 class="h5 mb-3">Busca tu edición</h2>
          <div class="input-group">
            <input class="form-control" id="buscador" placeholder="Buscar por nombre..." />
            <button class="btn btn-outline-light" type="button" onclick="filtrarRifas()">Buscar</button>
          </div>
          <div class="mt-3 filter-pills d-flex flex-wrap gap-2">
            <input type="radio" class="btn-check" name="estado" id="filtroTodos" value="" checked>
            <label class="btn btn-sm btn-outline-light" for="filtroTodos">Todas</label>

            <input type="radio" class="btn-check" name="estado" id="filtroActivas" value="ACTIVA">
            <label class="btn btn-sm btn-outline-light" for="filtroActivas">Activas</label>

            <input type="radio" class="btn-check" name="estado" id="filtroProximas" value="PROXIMA">
            <label class="btn btn-sm btn-outline-light" for="filtroProximas">Próximas</label>

            <input type="radio" class="btn-check" name="estado" id="filtroCerradas" value="CERRADA">
            <label class="btn btn-sm btn-outline-light" for="filtroCerradas">Cerradas</label>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


    <main class="py-5" id="explorar">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="h4 mb-0">Ediciones disponibles</h2>
      <a href="#" data-bs-toggle="modal" data-bs-target="#comoFuncionaModal" class="link-secondary">¿Cómo funciona?</a>
    </div>

    <div class="row g-4" id="gridRifas">
      <div class="col-12 col-sm-6 col-lg-4" th:each="r : ${raffles}"
           th:attr="data-estado=${r.estadoEdicion.nombre}, data-nombre=${r.nombre}">
        <div class="card raffle-card h-100 position-relative">
           <div class="ratio ratio-16x9 bg-light">
                <img th:if="${r.pathImagen}" th:src="${r.pathImagen}" class="card-img-top object-fit-cover" alt="imagen rifa">
                <div th:if="${r.pathImagen == null}" class="placeholder-image d-flex align-items-center justify-content-center">
                  <span class="text-muted">Sin imagen</span>
                </div>
              </div>

          <div class="card-body d-flex flex-column">
            <h3 class="h6 mb-1" th:text="${r.nombre}">Título edición</h3>

            <!-- Precio + cuenta regresiva (opcional) -->
            <div class="d-flex justify-content-between align-items-center mb-2">
              <div class="price-tag" th:if="${r.precioBoleto != null}"
                   th:text="${#numbers.formatDecimal(r.precioBoleto, 1, 'COMMA', 2, 'POINT')} + ' MXN'">
                $0.00 MXN
              </div>
              <div class="countdown text-muted" th:if="${r.fechaFin != null}"
                   th:attr="data-fin=${r.fechaFin}">
                <!-- se llena por JS -->
              </div>
            </div>

            <!-- Progreso -->
<!--             <div class="progress progress-sm mb-3" th:if="${r.progressPercent != null}"> -->
<!--               <div class="progress-bar" role="progressbar" -->
<!--                    th:style="'width:' + ${r.progressPercent} + '%'" -->
<!--                    th:text="${r.progressPercent} + '%'">0% -->
<!--               </div> -->
<!--             </div> -->

            <div class="mt-auto d-flex gap-2">
              <!-- AJUSTA la ruta al detalle/compra de tu app -->
              <a class="btn btn-primary w-100"
                 th:href="@{/detalle/{id}(id=${r.id})}">
                Participar ahora
              </a>
              <a class="btn btn-outline-secondary"
                 th:href="@{/detalle/{id}(id=${r.id})}">
                Ver más
              </a>
            </div>
            
             <span class="badge position-absolute top-0 end-0 m-3 bg-success" th:if="${r.estadoEdicion.nombre == 'ACTIVA'}">Activa</span>
                <span class="badge position-absolute top-0 end-0 m-3 bg-secondary" th:if="${r.estadoEdicion.nombre == 'PROXIMA'}">Próxima</span>
                <span class="badge position-absolute top-0 end-0 m-3 bg-dark" th:if="${r.estadoEdicion.nombre == 'CERRADA'}">Cerrada</span>
          </div>
        </div>
      </div>

      <!-- Vacío -->
      <div class="col-12 d-none" id="emptyState">
        <div class="text-center text-muted py-5">
          <p class="mb-0">No encontramos ediciones con esos filtros.</p>
        </div>
      </div>
    </div>
  </div>
</main>


    <footer class="py-4 bg-dark text-white-50">
      <div class="container d-flex justify-content-between align-items-center">
        <span>&copy; <span th:text="${#dates.format(#dates.createNow(), 'yyyy')}">2025</span> BARAJAS CLUB</span>
        <nav class="d-flex gap-3">
          <a class="link-light link-opacity-75" href="#">Términos</a>
          <a class="link-light link-opacity-75" href="#">Privacidad</a>
          <a class="link-light link-opacity-75" href="#">Contacto</a>
        </nav>
      </div>
    </footer>
    
    
    
    
    <div class="modal fade" id="comoFuncionaModal" tabindex="-1" aria-labelledby="comoFuncionaLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-0">
        <h5 class="modal-title" id="comoFuncionaLabel">¿Cómo funciona Barajas Club?</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <ol class="mb-0">
          <li>Elige una edición activa.</li>
          <li>Selecciona tus números o usa selección automática.</li>
          <li>Completa tu compra y recibe tu folio.</li>
          <li>Revisa los resultados en la fecha indicada.</li>
        </ol>
      </div>
      <div class="modal-footer border-0">
        <button class="btn btn-primary" data-bs-dismiss="modal">Entendido</button>
      </div>
    </div>
  </div>
</div>
    
    
    
    <script>
  function filtrarRifas() {
    const q = (document.getElementById('buscador')?.value || '').toLowerCase().trim();
    const estado = [...document.querySelectorAll('input[name="estado"]')].find(r => r.checked)?.value || '';
    const cards = document.querySelectorAll('#gridRifas [data-estado]');
    let visibles = 0;

    cards.forEach(card => {
      const matchesNombre = card.getAttribute('data-nombre')?.toLowerCase().includes(q);
      const matchesEstado = !estado || card.getAttribute('data-estado') === estado;
      const ok = matchesNombre && matchesEstado;
      card.classList.toggle('d-none', !ok);
      if (ok) visibles++;
    });
    document.getElementById('emptyState')?.classList.toggle('d-none', visibles !== 0);
  }

  // listeners
  document.querySelectorAll('input[name="estado"]').forEach(r => r.addEventListener('change', filtrarRifas));
  document.getElementById('buscador')?.addEventListener('input', () => {
    // pequeña espera para no filtrar por cada tecla (opcional)
    clearTimeout(window.__fDelay);
    window.__fDelay = setTimeout(filtrarRifas, 180);
  });

  // countdown simple
  function initCountdowns() {
    const nodes = document.querySelectorAll('.countdown[data-fin]');
    const tick = () => {
      const now = new Date();
      nodes.forEach(n => {
        const fin = new Date(n.getAttribute('data-fin'));
        const diff = fin - now;
        if (diff <= 0) { n.textContent = 'Finalizada'; return; }
        const d = Math.floor(diff / (1000*60*60*24));
        const h = Math.floor((diff / (1000*60*60)) % 24);
        const m = Math.floor((diff / (1000*60)) % 60);
        n.textContent = `${d}d ${h}h ${m}m`;
      });
    };
    tick(); setInterval(tick, 60*1000);
  }
  document.addEventListener('DOMContentLoaded', () => { filtrarRifas(); initCountdowns(); });
</script>
    
    
    
  </body>
</html>
