<script th:inline="javascript">
/*<![CDATA[*/
document.addEventListener('DOMContentLoaded', () => {
  const BASE      = /*[[@{/}]]*/ '/';
  const form      = document.querySelector('form[th\\:action="@{/admin/comprar}"], form[action$="/admin/comprar"]') || document.querySelector('form[action*="/admin/comprar"]');
  const email     = document.getElementById('email');
  const telefono  = document.getElementById('telefono');
  const clienteId = document.getElementById('clienteId');

  // Modal y elementos del modal
  const modalEl   = document.getElementById('clienteExistenteModal');
  const modal     = modalEl ? (bootstrap.Modal.getOrCreateInstance(modalEl)) : null;
  const cliNom    = document.getElementById('cliNombre');
  const cliEmail  = document.getElementById('cliEmail');
  const cliTel    = document.getElementById('cliTel');
  const btnUsar   = document.getElementById('btnUsarCliente');

  // 1) Validar que al menos uno (email o telefono) esté lleno
  function validarContactoRequerido() {
    const hasEmail = (email?.value || '').trim().length > 0;
    const hasTel   = (telefono?.value || '').trim().length > 0;

    if (!hasEmail && !hasTel) {
      // marca ambos con mensaje para que reportValidity muestre feedback nativo
      email?.setCustomValidity('Proporciona correo electrónico o teléfono (uno es requerido).');
      telefono?.setCustomValidity('Proporciona correo electrónico o teléfono (uno es requerido).');
      return false;
    } else {
      email?.setCustomValidity('');
      telefono?.setCustomValidity('');
      return true;
    }
  }

  email?.addEventListener('input', validarContactoRequerido);
  telefono?.addEventListener('input', validarContactoRequerido);

  // 2) Antes de enviar, chequeo de duplicados por AJAX
  form?.addEventListener('submit', async (e) => {
    if (!validarContactoRequerido() || !form.checkValidity()) {
      e.preventDefault();
      form.reportValidity();
      return;
    }
    // si ya decidimos clienteId previamente (del modal), no vuelvas a checar
    if (clienteId?.value) return;

    e.preventDefault();
    try {
      const params = new URLSearchParams({
        email: (email?.value || '').trim(),
        telefono: (telefono?.value || '').trim()
      });
      const res = await fetch(`${BASE}admin/clientes/check?${params.toString()}`, { cache: 'no-store' });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();

      if (data && data.exists) {
        // llena modal
        cliNom && (cliNom.textContent   = data.nombre || '—');
        cliEmail && (cliEmail.textContent = data.email  || '—');
        cliTel && (cliTel.textContent     = data.telefono || '—');

        // guardar id temporal en dataset para usarlo al confirmar
        modalEl.dataset.clienteId = data.id || '';

        modal?.show();
      } else {
        // no existe duplicado -> enviar normal
        form.submit();
      }
    } catch (err) {
      console.error('Error verificando cliente existente', err);
      // En caso de error de red, deja continuar el flujo normal
      form.submit();
    }
  });

  // 3) “Usar cliente existente” desde el modal
  btnUsar?.addEventListener('click', () => {
    const id = modalEl?.dataset?.clienteId || '';
    if (id && clienteId) {
      clienteId.value = id;     // pasamos el id al form
      modal?.hide();
      form?.submit();           // reenviamos el form con el cliente existente
    }
  });
});
/*]]>*/
</script>






