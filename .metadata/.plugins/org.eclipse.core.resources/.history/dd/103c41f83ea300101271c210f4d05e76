<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head th:replace="~{fragments_admin :: head('Comprar boleto')}"></head>


<script th:inline="javascript">
/*<![CDATA[*/
document.addEventListener('DOMContentLoaded', () => {
  // Datos base desde Thymeleaf
  let RIFA_ID       = /*[[${rifaSeleccionada != null ? rifaSeleccionada.id : 0}]]*/ 0;
  let NUM_POR_BOLETO= /*[[${numPorBoleto}]]*/ 1;

  // Estado de paginación
  let PAGE = 0;
  let SIZE = 120;
  let TOTAL_PAGES = 1;

  // Selección global (persiste entre páginas)
  const SELECCION = new Set();

  // UI
  const BASE      = /*[[@{/}]]*/ '/';
  const grid      = document.getElementById('gridNumeros');
  const input     = document.getElementById('numeroTicket');
  const selCount  = document.getElementById('selCount');
  const selRifa   = document.getElementById('selectRifa');
  const btnPrev   = document.getElementById('btnPrev');
  const btnNext   = document.getElementById('btnNext');
  const pageInfo  = document.getElementById('pageInfo');
  const pageSize  = document.getElementById('pageSize');

  function refreshInput(){
    const arr = Array.from(SELECCION).sort((a,b)=>parseInt(a,10)-parseInt(b,10));
    input.value = arr.join(', ');
    if (selCount) selCount.textContent = String(arr.length);
  }

  function makeBtn(label, state){
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'btn btn-sm num-btn';
    btn.dataset.label = label;
    btn.dataset.num   = String(parseInt(label,10));
    btn.textContent = label;

    if (state === 'disp') {
      btn.classList.add('btn-success');
      // Si ya está seleccionado de otra página, reflejarlo
      if (SELECCION.has(label)) {
        btn.classList.remove('btn-success');
        btn.classList.add('btn-primary','selected');
      }
    } else if (state === 'ap') {
      btn.classList.add('btn-warning');
      btn.disabled = true;
      btn.title = 'Apartado';
    } else {
      btn.classList.add('btn-dark');
      btn.disabled = true;
      btn.title = 'Pagado';
    }
    return btn;
  }

  function buildGrid(items){
    grid.innerHTML = '';
    const frag = document.createDocumentFragment();
    for (const it of items) {
      frag.appendChild(makeBtn(it.label, it.state));
    }
    grid.appendChild(frag);
  }

  function updatePagerUI(){
    pageInfo && (pageInfo.textContent = `Página ${PAGE+1} / ${Math.max(TOTAL_PAGES,1)}`);
    btnPrev && (btnPrev.disabled = PAGE <= 0);
    btnNext && (btnNext.disabled = PAGE >= TOTAL_PAGES - 1);
  }

  async function loadPage(p){
    const url = `${BASE}admin/rifa/${RIFA_ID}/numeros-simple?page=${p}&size=${SIZE}&_=${Date.now()}`;
    const res = await fetch(url, { cache: 'no-store' });
    if (!res.ok) throw new Error('HTTP '+res.status);
    const data = await res.json();

    // Actualiza límites y metadatos
    PAGE = data.page ?? 0;
    SIZE = data.size ?? SIZE;
    TOTAL_PAGES = data.totalPages ?? 1;
    NUM_POR_BOLETO = data.numPorBoleto ?? NUM_POR_BOLETO;

    buildGrid(data.items || []);
    updatePagerUI();
    refreshInput();
    // Actualiza leyenda (opcional): contadores globales
    const cDisp = data.counts?.disp ?? 0;
    const cAp   = data.counts?.ap   ?? 0;
    const cPag  = data.counts?.pag  ?? 0;
    // Si quieres reflejarlo en el DOM:
    // document.querySelector('[data-count="disp"]').textContent = cDisp;
    // ...
  }

  // Delegación clicks en grilla
  grid.addEventListener('click', (e)=>{
    const btn = e.target.closest('.num-btn');
    if (!btn || btn.disabled) return;

    const label = btn.dataset.label || btn.textContent.trim();
    const isOn  = SELECCION.has(label);

    // Respeta el límite dinámico: numPorBoleto * boletos
    const cantBoletos = Number(document.getElementById('selBoletos')?.value || 1);
    const MAX = NUM_POR_BOLETO * cantBoletos;
    if (!isOn && SELECCION.size >= MAX) return;

    if (isOn){
      SELECCION.delete(label);
      btn.classList.remove('btn-primary','selected');
      btn.classList.add('btn-success');
    } else {
      SELECCION.add(label);
      btn.classList.remove('btn-success');
      btn.classList.add('btn-primary','selected');
    }
    refreshInput();
  });

  // Botones de paginación
  btnPrev?.addEventListener('click', async () => {
    if (PAGE > 0) await loadPage(PAGE - 1);
  });
  btnNext?.addEventListener('click', async () => {
    if (PAGE < TOTAL_PAGES - 1) await loadPage(PAGE + 1);
  });
  pageSize?.addEventListener('change', async () => {
    SIZE = parseInt(pageSize.value, 10) || 120;
    PAGE = 0;
    await loadPage(PAGE);
  });

  // Cambio de rifa: reinicia selección y paginación
  selRifa?.addEventListener('change', async (e) => {
    const newId = Number(e.target.value);
    if (!newId) return;
    RIFA_ID = newId;
    SELECCION.clear();
    PAGE = 0;
    await loadPage(PAGE);
  });

  // Cambio de cantidad de boletos también puede “recortar” si excede el nuevo máximo
  document.getElementById('selBoletos')?.addEventListener('change', () => {
    const cantBoletos = Number(document.getElementById('selBoletos').value || 1);
    const newMAX = NUM_POR_BOLETO * cantBoletos;
    // Si te pasaste, recorta conservando los más pequeños
    if (SELECCION.size > newMAX) {
      const ordenados = Array.from(SELECCION).sort((a,b)=>parseInt(a,10)-parseInt(b,10));
      SELECCION.clear();
      for (let i = 0; i < newMAX; i++) SELECCION.add(ordenados[i]);
      // Re-pinta la página actual para reflejar visualmente el recorte
      loadPage(PAGE).catch(console.error);
    }
    refreshInput();
  });

  // Carga inicial
  if (RIFA_ID) {
    loadPage(PAGE).catch(err => {
      console.error('Error cargando números paginados', err);
    });
  }
});
/*]]>*/
</script>








