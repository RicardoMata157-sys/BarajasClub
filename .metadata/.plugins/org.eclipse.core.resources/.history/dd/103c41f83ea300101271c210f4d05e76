								th:text="${ticketGroup != null ? ticketGroup.cantidadBoletos : 0}">0</strong>
							<span class="ms-2">· Números por boleto:</span> <strong
								th:text="${ticketGroup != null ? ticketGroup.numerosPorBoleto : 1}">1</strong>
						</div>
						<div class="text-end">
							<div class="muted">Total</div>
							<div class="fs-5 fw-bold"
								th:text="${ticketGroup != null && ticketGroup.total != null 
                         ? '$ ' + #numbers.formatDecimal(ticketGroup.total, 1, 2) 
                         : '$ 0.00'}">$
								0.00</div>
